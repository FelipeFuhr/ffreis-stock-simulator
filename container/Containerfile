# scan-fix(trivy:GHSA-4w2j-m93h-cj5j): bump uv 0.11.10 -> 0.12.5 — the bundled quinn-proto
# (0.11.14, remote memory exhaustion) is fixed at 0.11.15 in this release.
FROM ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 AS uv

# scan-fix(trivy:CVE-2026-53615/CVE-2026-4878/CVE-2026-45447): refresh python:3.14-slim digest
# to pick up Debian's util-linux/libcap2/openssl security updates (13 HIGH findings, all
# already patched upstream — the prior digest just predated the rebuild).
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY proto ./proto
COPY scripts ./scripts
COPY src ./src
COPY examples ./examples

RUN uv venv "${VIRTUAL_ENV}" --python 3.13 \
    && ./scripts/generate_grpc_stubs.sh \
    && uv sync --active --frozen --extra api --extra grpc \
    && chown -R appuser:appuser /app "${VIRTUAL_ENV}" /opt/uv-python

USER appuser

CMD ["python", "-m", "stock_simulator.server"]
